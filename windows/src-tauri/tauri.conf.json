{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Safespace",
  "version": "1.2.1",
  "identifier": "app.safespace.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Safespace",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#E9E8E4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "David Winkler",
    "copyright": "© 2026 David Winkler · MIT License",
    "category": "Utility",
    "shortDescription": "A private, offline password manager",
    "longDescription": "Safespace keeps your logins in one AES-256 encrypted file on this PC. No account, no sync, no network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
